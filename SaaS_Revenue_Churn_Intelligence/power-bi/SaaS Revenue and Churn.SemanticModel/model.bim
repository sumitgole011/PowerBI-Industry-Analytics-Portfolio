            "sourceColumn": "StartingMRR",
            "dataType": "decimal",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "EndingMRR",
            "sourceColumn": "EndingMRR",
            "dataType": "decimal",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "ExpansionMRR",
            "sourceColumn": "ExpansionMRR",
            "dataType": "decimal",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "ContractionMRR",
            "sourceColumn": "ContractionMRR",
            "dataType": "decimal",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
