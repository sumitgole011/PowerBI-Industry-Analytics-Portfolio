            "sourceColumn": "ChurnMRR",
            "dataType": "decimal",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "ActiveBOM",
            "sourceColumn": "ActiveBOM",
            "dataType": "int64",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "ChurnedLogos",
            "sourceColumn": "ChurnedLogos",
            "dataType": "int64",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "ActiveEOM",
            "sourceColumn": "ActiveEOM",
            "dataType": "int64",
            "summarizeBy": "sum",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Monthly recurring revenue",
            "expression": [
              "VAR LastMonth = MAX ( 'SaaS Monthly'[Month] )",
              "RETURN CALCULATE ( SUM ( 'SaaS Monthly'[EndingMRR] ), KEEPFILTERS ( 'SaaS Monthly'[Month] = LastMonth ) )"
            ],
            "formatString": "$#,0.00",
            "description": "End-of-month recurring revenue for the latest selected month."
          },
          {
            "name": "Logo churn",
            "expression": "DIVIDE ( SUM ( 'SaaS Monthly'[ChurnedLogos] ), SUM ( 'SaaS Monthly'[ActiveBOM] ) )",
            "formatString": "0.00%",
            "description": "Start-of-month customer-weighted monthly churn over the selected period."
          },
          {
            "name": "Net revenue retention",
            "expression": [
              "VAR Base = SUM ( 'SaaS Monthly'[StartingMRR] )",
              "RETURN DIVIDE ( Base + SUM ( 'SaaS Monthly'[ExpansionMRR] ) - SUM ( 'SaaS Monthly'[ContractionMRR] ) - SUM ( 'SaaS Monthly'[ChurnMRR] ), Base )"
            ],
            "formatString": "0.00%",
            "description": "Starting MRR-weighted monthly retention, excluding new subscriptions."
          }
        ],
