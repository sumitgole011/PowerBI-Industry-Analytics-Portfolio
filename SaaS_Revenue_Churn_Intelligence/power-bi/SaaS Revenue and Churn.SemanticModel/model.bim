    "tables": [
      {
        "name": "SaaS Monthly",
        "description": "Synthetic subscriptions aggregated to one row per month and customer segment.",
        "columns": [
          {
            "name": "Month",
            "sourceColumn": "Month",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "Segment",
            "sourceColumn": "Segment",
            "dataType": "string",
            "summarizeBy": "none"
          },
